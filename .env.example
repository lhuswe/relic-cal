# Kopiera till .env och fyll i värden från det NYA Supabase-projektet (inte N-BV:s).
# Dashboard → Project Settings → API. Anon/publishable-nyckeln är publik och skyddas av RLS.
# .env är gitignorerad och committas aldrig.
VITE_SUPABASE_URL=din-supabase-url
VITE_SUPABASE_ANON_KEY=din-publishable-nyckel

# Bas-URL till edge-funktionen som genererar .ics-feeds.
# Format: https://<project-ref>.functions.supabase.co/feed
# (På sikt läggs feeds bakom cal.relic.se via proxy/custom domain.)
VITE_FEED_BASE_URL=https://din-project-ref.functions.supabase.co/feed
